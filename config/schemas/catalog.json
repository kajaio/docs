{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "hosted",
              "self-hosted"
            ]
          },
          "base_url": {
            "type": "string",
            "format": "uri"
          },
          "comment": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "models": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "task": {
                  "type": "string",
                  "enum": [
                    "chat",
                    "tts",
                    "stt",
                    "embedding",
                    "image-generation",
                    "rerank",
                    "summarize"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "task",
                "model"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "base_url",
          "models"
        ]
      }
    },
    "examples": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^models\\.[a-z0-9-]+\\.toml$"
          },
          "providers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pick": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "chat",
                "tts",
                "stt",
                "embedding",
                "image-generation",
                "rerank",
                "summarize"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "file",
          "providers"
        ]
      }
    }
  },
  "required": [
    "providers"
  ]
}
