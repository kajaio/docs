{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "description": "System prompt",
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "object",
      "properties": {
        "chat": {
          "type": "string",
          "minLength": 1
        },
        "embedding": {
          "type": "string",
          "minLength": 1
        },
        "rerank": {
          "type": "string",
          "minLength": 1
        },
        "image-generation": {
          "type": "string",
          "minLength": 1
        },
        "tts": {
          "type": "string",
          "minLength": 1
        },
        "stt": {
          "type": "string",
          "minLength": 1
        },
        "summarize": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "when": {
      "type": "string",
      "minLength": 1
    },
    "abilities": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "skill": {
                "description": "The skill part: load (default, unless SKILL.md says sticky), sticky or off",
                "type": "string",
                "enum": [
                  "load",
                  "sticky",
                  "off"
                ]
              },
              "tools": {
                "description": "Only these of the ability's tools (HTTP, MCP and code tools); unset means all of them",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "roots": {
                "description": "Folders an MCP server with `roots = true` may use while this persona is active, e.g. [\"~/notes\", { path = \"~/site\", readOnly = true }]; without them it's off",
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "readOnly": {
                          "default": false,
                          "description": "The server may read here but not write, edit, move or create",
                          "type": "boolean"
                        },
                        "backup": {
                          "description": "Kaja copies a file here to its backups folder before the server writes, edits or moves it",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "path"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "localOnly": {
      "description": "Only on the user's own machine: the cloud leaves this persona out (its abilities work only locally)",
      "type": "boolean"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "top_k": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "max_tokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "frequency_penalty": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "presence_penalty": {
      "type": "number",
      "minimum": -2,
      "maximum": 2
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "label"
  ]
}
